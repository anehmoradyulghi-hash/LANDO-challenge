# ===== Telegram =====
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
BOT_USERNAME=YourPublicBotUsername
# Public HTTPS URL Telegram will call (no trailing slash), e.g. https://api.yourdomain.com
WEBHOOK_DOMAIN=https://your-domain.example.com
WEBHOOK_PATH=/telegram/webhook
# Optional secret token Telegram will echo back in X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=change-me-random-string

# ===== Server =====
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ===== Database (PostgreSQL only, no SQLite) =====
DATABASE_URL=postgresql://user:password@localhost:5432/telechallenge?schema=public

# ===== Business limits (never hard-code in source) =====
MAX_REQUIRED_CHANNELS=20
MAX_CHANNELS_PER_CREATOR=50
MAX_ACTIVE_CHALLENGES_PER_CREATOR=10
WIZARD_SESSION_TTL_HOURS=48
PARTICIPANT_COUNT_UPDATE_DEBOUNCE_MS=180000
PARTICIPANT_COUNT_UPDATE_MIN_DELTA=5
MEMBERSHIP_RECHECK_TTL_MINUTES=10

# ===== Scheduler =====
SCHEDULER_TICK_CRON=*/30 * * * * *

# ===== Logging =====
LOG_LEVEL=info
